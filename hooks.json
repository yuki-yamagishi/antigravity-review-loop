{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|invoke_subagent|start_subagent|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/safetyGuard.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "branch-dor-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/branchDoRGate.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pre-pr-audit-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/prePrAuditGate.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pr-body-audit-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/prBodyAuditGate.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "review-loop-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stopHook.js",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/postPrCreate.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
