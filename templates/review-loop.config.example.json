{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allowedTestCommands": [
    "npm test -- --run",
    "npm run test:run"
  ],
  "issuesDir": "docs/issues",
  "readyLabels": [
    "status: ready",
    "status: in-progress"
  ],
  "adrDir": "docs/adr",
  "ssotFile": "docs/architecture_overview.md",
  "issueTracker": "auto",
  "branchIssuePattern": "(?:issue[/-]|issue-|#|feat/|feature/|fix/)(\\d+)",
  "codeDirs": [
    "src",
    "frontend/src",
    "lib",
    "hooks",
    "state",
    "skills",
    "config",
    "scripts"
  ],
  "disallowedPrBodyTerms": [
    "撤回",
    "取りやめ",
    "取り下げ",
    "勝手に",
    "指摘され",
    "指摘を受け",
    "指摘により",
    "自作自演",
    "言い訳",
    "やっぱり",
    "戻した",
    "やめました"
  ],
  "autoOverwritePrBody": false,
  "subagentModels": {
    "dorAuditor": "flash",
    "completionAuditor": "flash",
    "codeReviewer": "inherit"
  }
}
